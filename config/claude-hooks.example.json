{
  "_readme": "Merge these entries into user-level Claude Code settings and replace the checkout path. Model and grill gates retain their documented blocking behavior. Orchestration hooks are nonblocking cost reminders: explicit mode commands set a preference; code volume never enables a veto. Pre/post volume reminders share one session marker, exempt workers, and respect explicit OFF. additionalContext carries the reminder without overriding permission decisions.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\path\\to\\agent-ladder\\hooks\\grill_gate.ps1\""
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\path\\to\\agent-ladder\\hooks\\orchestrate_flag.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\path\\to\\agent-ladder\\hooks\\grill_gate.ps1\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\path\\to\\agent-ladder\\hooks\\model_gate.ps1\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\path\\to\\agent-ladder\\hooks\\orchestrator_mode.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\path\\to\\agent-ladder\\hooks\\checkpoint_finisher_guard.ps1\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\path\\to\\agent-ladder\\hooks\\delegation_gate.ps1\""
          }
        ]
      }
    ]
  }
}
